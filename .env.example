# [1] ENV + Brand
# Runtime validation in production will fail fast if required values are invalid.
# Required minimum for production preflight:
# - NEXT_PUBLIC_SITE_URL (https URL, non-localhost)
# - SITE_URL (same origin as NEXT_PUBLIC_SITE_URL)
# - AUTH_SESSION_SECRET (32+ chars)
# - NEXT_PUBLIC_CONTACT_EMAIL
# - NEXT_PUBLIC_LEGAL_NAME
NEXT_PUBLIC_SITE_URL=
SITE_URL=
# Search Console / Webmaster verification tokens (optional but recommended)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=
AUTH_SESSION_SECRET=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_LEAD_MAGNET_URL_EN=
NEXT_PUBLIC_LEAD_MAGNET_URL_FR=
NEXT_PUBLIC_PRODUCT_CHECKOUT_URL=
# Optional override for Antigravity official URL shown in student tools.
NEXT_PUBLIC_ANTIGRAVITY_URL=https://www.antigravity.ai/

# [2] Donation (non-Stripe preferred)
NEXT_PUBLIC_DONATION_PRIMARY_URL=
NEXT_PUBLIC_DONATION_PAYPAL_URL=
# Optional direct card checkout (Mastercard/Visa), e.g. LemonSqueezy/Gumroad/PayPal donate button.
# Falls back to NEXT_PUBLIC_PRODUCT_CHECKOUT_URL if empty.
NEXT_PUBLIC_DONATION_CARD_URL=
NEXT_PUBLIC_DONATION_CARD_LABEL=Card checkout
NEXT_PUBLIC_DONATION_KOFI_URL=
NEXT_PUBLIC_DONATION_GITHUB_SPONSORS_URL=
# Keep empty for now (no Stripe integration)
NEXT_PUBLIC_DONATION_STRIPE_URL=

# [3] OAuth Decision
# Preferred toggle (true | false). If set, it overrides OAUTH_MODE.
ENABLE_OAUTH=false
# enable | disable
OAUTH_MODE=disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# [4] Email Automation
# convertkit | none
EMAIL_PROVIDER=none
CONVERTKIT_FORM_ID=
CONVERTKIT_API_KEY=
# [4.1] Abuse protection + distributed rate limiting
# Configure Upstash Redis to make rate limits/lockouts consistent across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# none | turnstile
BOT_PROTECTION_MODE=none
# keep client + server mode aligned
NEXT_PUBLIC_BOT_PROTECTION_MODE=none
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# credentials | passwordless
# - credentials: email + password login/register
# - passwordless: keeps legacy email request flow
AUTH_FLOW_MODE=credentials
# file | supabase
# - file: local JSON file store (dev/single-server)
# - supabase: managed Postgres via Supabase REST (recommended production)
AUTH_CREDENTIALS_BACKEND=file
# Supabase credentials backend config (required when AUTH_CREDENTIALS_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USERS_TABLE=auth_users
# Optional credentials user storage path.
# If empty, defaults to ./data/auth-users.json
AUTH_USERS_STORE_PATH=data/auth-users.json
# oauth_only | insecure_demo
# - oauth_only: no unverified email session login (recommended production)
# - insecure_demo: allows immediate email session login (dev/demo only)
EMAIL_AUTH_MODE=oauth_only

# [5] Affiliate Final Links (minimum 5)
AFFILIATE_1_NAME=
AFFILIATE_1_URL=
AFFILIATE_1_PLACEMENT=home/resources/blog/comparison

AFFILIATE_2_NAME=
AFFILIATE_2_URL=
AFFILIATE_2_PLACEMENT=

AFFILIATE_3_NAME=
AFFILIATE_3_URL=
AFFILIATE_3_PLACEMENT=

AFFILIATE_4_NAME=
AFFILIATE_4_URL=
AFFILIATE_4_PLACEMENT=

AFFILIATE_5_NAME=
AFFILIATE_5_URL=
AFFILIATE_5_PLACEMENT=

NEXT_PUBLIC_DIGITALOCEAN_REF=

# [6] Social Proof Content
REAL_STATS_LINE_1=
REAL_STATS_LINE_2=
REAL_STATS_LINE_3=

TESTIMONIAL_1_QUOTE=
TESTIMONIAL_1_NAME=
TESTIMONIAL_1_ROLE=

TESTIMONIAL_2_QUOTE=
TESTIMONIAL_2_NAME=
TESTIMONIAL_2_ROLE=

TESTIMONIAL_3_QUOTE=
TESTIMONIAL_3_NAME=
TESTIMONIAL_3_ROLE=

# [7] Founder/LinkedIn copy
FOUNDER_BIO_EN=
FOUNDER_BIO_FR=
LINKEDIN_SHORT_BIO_EN=
LINKEDIN_SHORT_BIO_FR=

# [8] Tracking
TRACKING_WEBHOOK_URL=
# none | ga4
ANALYTICS_MODE=none
GA4_MEASUREMENT_ID=
# local debug only (1=true, production should stay 0)
TRACKING_DEBUG=0
NEXT_PUBLIC_TRACKING_DEBUG=0

# [9] Legal polish
PRIVACY_CONTACT_EMAIL=
TERMS_LEGAL_ENTITY=
AFFILIATE_DISCLOSURE_TEXT_EN=
AFFILIATE_DISCLOSURE_TEXT_FR=

# [10] Auto News Agent (optional)
# max stored auto-ingested items
AUTO_NEWS_MAX_ITEMS=240
# hard cap per source feed in stored dataset
AUTO_NEWS_MAX_PER_SOURCE=24
# 1 = keep cap strict (better source diversity), 0 = allow overflow fallback
AUTO_NEWS_STRICT_SOURCE_CAP=1
# UI cap per source when rendering auto-news blocks
AUTO_NEWS_UI_MAX_PER_SOURCE=12
# UI cap per source for live stream aggregation
LIVE_NEWS_MAX_PER_SOURCE=8
# keep items newer than X days
AUTO_NEWS_MAX_AGE_DAYS=45
# if all live sources fail and cached items are below this threshold,
# write official-source baseline news items instead of leaving feed empty
AUTO_NEWS_MIN_BOOTSTRAP_ITEMS=6

# [10.1] Auto Tools Agent (optional)
# max stored auto-ingested tools
AUTO_TOOLS_MAX_ITEMS=120
# hard cap per source feed in stored dataset
AUTO_TOOLS_MAX_PER_SOURCE=16
# keep items newer than X days
AUTO_TOOLS_MAX_AGE_DAYS=120
# if all live sources fail and cached tools are below this threshold,
# write official-source baseline tools instead of leaving feed empty
AUTO_TOOLS_MIN_BOOTSTRAP_ITEMS=8

# [11] Blog Operator Agent (internal/private planning only)
# monthly traffic assumption for revenue model
AGENT_MONTHLY_VISITS_TARGET=300
# affiliate conversion assumptions
AGENT_AFFILIATE_CTR_TARGET=0.04
AGENT_AFFILIATE_CVR_TARGET=0.08
AGENT_AFFILIATE_COMMISSION_USD=10
# product assumptions
AGENT_PRODUCT_CVR_TARGET=0.005
AGENT_PRODUCT_PRICE_USD=12
# email assumptions
AGENT_EMAIL_OPTIN_TARGET=0.03
AGENT_EMAIL_TO_PRODUCT_CVR=0.02
# editorial balance thresholds (AI + CS)
# minimum CS share in long-form editorial inventory
AGENT_MIN_CS_SHARE=0.35
# maximum AI share before operator pushes rebalance actions
AGENT_MAX_AI_SHARE=0.60
# private draft generation
AGENT_DRAFTS_PER_RUN=2

# [11b] Blog Writer Agent (LLM-powered full-draft generation, optional)
# Requires an Anthropic API key. When unset, the writer agent skips gracefully.
# Output: docs/agent/drafts/llm/*.md (review-required, never auto-published).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
# AGENT_WRITER_DRAFTS_PER_RUN=2
# AGENT_WRITER_MAX_TOKENS=16000

# [12] Operator issue sync (GitHub Issues from docs/agent/next-actions.json)
# enable/disable automatic issue creation
AGENT_ISSUES_ENABLED=1
# cap created issues per run
AGENT_ISSUES_MAX_PER_RUN=3
# include operator queue (docs/agent/next-actions.json)
AGENT_ISSUES_INCLUDE_OPERATOR=1
# include design queue (docs/agent/design-actions.json)
AGENT_ISSUES_INCLUDE_DESIGN=1

# [13] Blog Design Agent (internal UI audit)
# target score out of 100
DESIGN_AGENT_TARGET_SCORE=88
# max queued design actions in report
DESIGN_AGENT_MAX_ACTIONS=10

# [14] Agent pipeline orchestration
# run auto-news step in agent:all
AGENT_PIPELINE_INCLUDE_AUTO_NEWS=1
# run operator step in agent:all
AGENT_PIPELINE_INCLUDE_OPERATOR=1
# run design step in agent:all
AGENT_PIPELINE_INCLUDE_DESIGN=1
# generate docs/agent/daily-checklist.md from operator queues
AGENT_PIPELINE_INCLUDE_DAILY_CHECKLIST=1
# run issue sync step in agent:all
AGENT_PIPELINE_INCLUDE_ISSUES=1
# run health verification step in agent:all
AGENT_PIPELINE_INCLUDE_VERIFY=1
# run public-content privacy check in agent:all
AGENT_PIPELINE_INCLUDE_PUBLIC_CONTENT_VERIFY=1
# write docs/agent/pipeline report/status files
AGENT_PIPELINE_WRITE_REPORTS=1
# cap issue creation in pipeline issue sync
AGENT_PIPELINE_ISSUES_MAX_PER_RUN=6
# freshness threshold for verify:agents warnings
AGENT_HEALTH_MAX_AGE_HOURS=96

# [15] Internal pages
# Keep private growth page hidden in production by default.
# Set to true only if you explicitly want to expose /{lang}/growth-sprint.
ENABLE_INTERNAL_GROWTH_SPRINT=false

# [16] Autopilot agent
# Number of full retries when quality gates fail.
AUTOPILOT_MAX_RETRIES=2
# Defaults for local runs. CI workflow overrides as needed.
AUTOPILOT_PULL=true
AUTOPILOT_COMMIT=false
AUTOPILOT_PUSH=false
AUTOPILOT_COMMIT_MESSAGE=chore(autopilot): refresh blog quality and content
